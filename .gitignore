__pycache__/
*.pyc
.pytest_cache/
runs/*
!runs/.gitkeep
.venv/
*.egg-info/

# Secrets and local orchestration state -- never committed. API keys are
# read only from environment variables at call time (see
# benchmark/providers/nvidia.py's module docstring); nothing in this repo
# writes one to disk, but this is a defense-in-depth backstop.
.env
.env.*
registry.json
executions.jsonl
routing.jsonl

# Operator-supplied price list (real commercial figures) -- copy from
# configs/model_costs.example.json. Never committed.
configs/model_costs.json

# Standalone bundles are build output of tools_build_standalone.py --
# ~4.8MB each and fully reproducible from frontend/ + frontend/vendor/.
frontend/dist/

# Student engine local database and uploaded sources -- per-deployment data,
# never committed.
# Any SQLite database and its sidecars, not one name.
#
# This used to read `quintek.db` / `quintek.db-*`. A second database arrived
# later called `billing.db` and matched neither, so it and a 552 KB WAL were
# committed in 367dccd. The WAL held no credential and one opaque generated
# user id, but a rule written around a single filename is a rule that only
# covers the database someone remembered.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
sources/

# Generation-run artifacts: per-run captures, useful locally, not repo content.
generation_run/
alpha0_runs/

# Backup written by tools_mark_test_records.py
executions.jsonl.before-marking
