<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Quintek" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/quintek_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- The learner screen draws its own header and tabs; a native title bar
         above them would be a second, competing chrome. -->
    <style name="Theme.Quintek.NoActionBar" parent="Theme.Quintek">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
